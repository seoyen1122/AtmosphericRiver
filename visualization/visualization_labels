import netCDF4 as nc
import matplotlib.pyplot as plt
from mpl_toolkits.basemap import Basemap
import numpy as np
import cartopy.crs as ccrs
from matplotlib.colors import ListedColormap

ncfile = nc.Dataset("C:/Users/seoye/ar/climatenet/test/data-2011-06-01-01-1_0.nc","r",format="nc")

lat = ncfile.variables['lat'][:]
lon = ncfile.variables['lon'][:]
LABELS = ncfile.variables['LABELS'][:]
fig, ax = plt.subplots(figsize=(10, 7))

ar_mask = (LABELS == 2)

fig = plt.figure(figsize=(10, 8))
ax = plt.axes(projection=ccrs.PlateCarree())

cmap = ListedColormap(['white', 'red'])

pcm = ax.imshow(ar_mask, extent=[lon.min(), lon.max(), lat.min(), lat.max()], origin='lower', cmap=cmap)

ax.coastlines() 
ax.set_title('AR Visualization')

plt.legend()
plt.show()